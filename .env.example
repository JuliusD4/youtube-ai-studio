# ==========================================
# AI YouTube Studio - Environment Variables
# ==========================================

# Pexels API Key (Free tier at https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# Kaggle Access Token (from Kaggle Settings -> API -> Create New Token)
KAGGLE_API_TOKEN=your_kaggle_api_token_here

# Optional: Path to custom voice reference WAV file for Chatterbox voice cloning
# CUSTOM_VOICE_SAMPLE=assets/my_voice_sample.wav
